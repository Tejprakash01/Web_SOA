# Environment Configuration - CampusConnect Lab 9 Generative AI Integration

# API Gateway Configuration
PORT=3000
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004

# Microservices Ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
AI_SERVICE_PORT=3004

# Inter-Service Communication Timeout
INTER_SERVICE_TIMEOUT_MS=3000

# MongoDB Database Connection String (Local / Mongo Atlas)
MONGO_URI=mongodb://localhost:27017/campusconnect_db

# ============================================================
# Generative AI Provider Configuration (Lab 9)
# ============================================================
# Provider: 'gemini' (Google AI Studio) or 'openai' or 'mock' (offline test mode)
AI_PROVIDER=gemini

# Provider API Key (Keep strictly server-side; NEVER commit live keys!)
AI_API_KEY=replace_with_your_key

# Hosted Model Identifier (e.g. gemini-1.5-flash or gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# Maximum Request Timeout in Milliseconds (Section 3.1)
AI_TIMEOUT_MS=30000

# Maximum Input Character Limit for Validation
MAX_INPUT_CHARS=5000

# Mock Mode (Set to true to run test cases offline without external API quota)
AI_MOCK=false

