# CampusConnect AI Service Environment Configuration (Lab 9)
# Note: Never commit actual API keys or secrets to Git.

# AI Service Port
AI_SERVICE_PORT=3004

# Provider Selection: gemini | openai | mock
AI_PROVIDER=gemini

# Provider API Key (Keep strictly confidential server-side)
AI_API_KEY=replace_with_your_api_key

# Model Identifier (e.g., gemini-1.5-flash for Google Gemini, or gpt-4o-mini for OpenAI)
AI_MODEL=gemini-1.5-flash

# Maximum Request Timeout in Milliseconds
AI_TIMEOUT_MS=30000

# Input Length Limit (Characters)
MAX_INPUT_CHARS=5000

# Offline / Mock Simulation Mode (Set to true to run test suites offline without API key)
AI_MOCK=false

